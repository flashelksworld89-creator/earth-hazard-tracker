{
  "functions": {
    "api/gdacs.js": {
      "maxDuration": 10
    },
    "api/atmospheric-rivers.js": {
      "maxDuration": 30
    },
    "api/space-weather.js": {
      "maxDuration": 10
    },
    "api/glotec.js": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
